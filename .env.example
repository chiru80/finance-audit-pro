# Finance Audit Pro - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-supabase-key

# Optional: Build configuration
# VITE_APP_NAME=Finance Audit Pro
# VITE_APP_URL=https://weeklyfinance.online

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Create a new Supabase project at https://supabase.com
#
# 2. Copy these values from your Supabase project:
#    - Project URL: Found in your Supabase dashboard > Project Settings > General
#    -anon key: Found in your Supabase dashboard > Project Settings > API > anon key
#
# 3. Export these values in your shell or add to .env:
#    export VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
#    export VITE_SUPABASE_ANON_KEY="<anon-key>"
#
# 4. Build and run the application:
#    npm run build    # For production
#    npm start        # For development (requires ng serve)
#
# =============================================================================
# DONT MISSING VALUES FROM .env
# =============================================================================